---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found | Cartospatial Technologies" description="The page you are looking for was not found." noindex>
  <section class="hero-band" style="padding-block:clamp(80px,10vw,140px)">
    <h1>Page not found</h1>
    <p>The page may have moved. Try one of these:</p>
    <div class="hero-actions">
      <a class="btn-cta" href="/">Home</a>
      <a class="btn btn--ghost" href="/services/">Services</a>
      <a class="btn btn--ghost" href="/locations/">Locations</a>
      <a class="btn-cta btn-wa" href="/contact/">Contact</a>
    </div>
  </section>
</BaseLayout>
