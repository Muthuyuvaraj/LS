---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
import { SERVICES } from '../../data/services';
import { breadcrumb } from '../../data/schema';
---
<BaseLayout
  title="Land Survey Services in Tamil Nadu | DGPS, Drone, Total Station, LiDAR, GIS"
  description="All Cartospatial survey services in one place – Total Station, DGPS, drone, photogrammetry, LiDAR, bathymetric, GIS mapping and data processing across Tamil Nadu."
  schema={[breadcrumb([{ name: 'Home', path: '/' }, { name: 'Services', path: '/services/' }])]}
>
  <section class="hero-band">
    <h1>Land Survey &amp; Mapping Services</h1>
    <p>Eight specialised survey services, delivered by one team across all 38 districts of Tamil Nadu.</p>
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> › <span aria-current="page">Services</span></nav>
  </section>
  <main class="section">
    <div class="section-inner card-grid">
      {SERVICES.map((s) => (
        <a class="card" href={`/services/${s.slug}/`}>
          <img src={s.image} alt={s.name} loading="lazy" width="400" height="220" style="width:100%;height:170px;object-fit:cover;border-radius:8px;margin-bottom:12px" />
          <h2 style="font-size:18px;color:#071c34;margin:0 0 6px">{s.name}</h2>
          <p>{s.short}</p>
        </a>
      ))}
    </div>
  </main>
  <CtaBand />
</BaseLayout>
