---
import { SITE, waLink } from '../data/site';
import { SERVICES } from '../data/services';
interface Props { lang: 'en' | 'ta'; alternate?: string }
const { lang, alternate } = Astro.props;
const ta = lang === 'ta';
const home = ta ? '/ta/' : '/';
const svcHref = (slug: string) => (ta ? `/ta/services/${slug}/` : `/services/${slug}/`);
const t = ta
  ? { home: 'முகப்பு', company: 'நிறுவனம்', about: 'எங்களைப் பற்றி', team: 'குழு', projects: 'திட்டங்கள்', work: 'எங்கள் பணிகள்', services: 'சேவைகள்', allServices: 'அனைத்து சேவைகள் →', locations: 'இடங்கள்', estimator: 'செலவு மதிப்பீடு', contact: 'தொடர்பு', quote: 'விலைப்புள்ளி பெற', call: 'அழைக்க', hours: 'திங்கள் – சனி, காலை 9 – மாலை 6', switchLabel: 'English', menu: 'மெனு' }
  : { home: 'Home', company: 'Company', about: 'About Us', team: 'Our Team', projects: 'Projects', work: 'Our Work', services: 'Services', allServices: 'View all services →', locations: 'Locations', estimator: 'Cost Estimator', contact: 'Contact', quote: 'Get a Free Quote', call: 'Call us', hours: SITE.hoursText, switchLabel: 'தமிழ்', menu: 'Menu' };
const switchHref = alternate ?? (ta ? '/' : '/ta/');
const company = [
  { href: '/about/', label: t.about },
  { href: '/team/', label: t.team },
  { href: '/faq/', label: 'FAQ' },
];
---
<div class="topbar">
  <div class="container">
    <ul>
      <li class="only-mobile"><a href={`tel:${SITE.phoneRaw}`} data-track="call"><i class="fa-solid fa-phone" aria-hidden="true"></i>{SITE.phone}</a></li>
      <li class="only-desktop"><a href={waLink(ta ? 'வணக்கம் Cartospatial, எனக்கு நில அளவை பற்றி விவரம் வேண்டும்.' : 'Hi Cartospatial, I need details about a land survey.')} target="_blank" rel="noopener" data-track="whatsapp"><i class="fa-brands fa-whatsapp" aria-hidden="true"></i>WhatsApp {SITE.phone}</a></li>
      <li class="hide-sm"><a href={`mailto:${SITE.email}`} data-track="email"><i class="fa-regular fa-envelope" aria-hidden="true"></i>{SITE.email}</a></li>
      <li class="hide-sm"><i class="fa-regular fa-clock" aria-hidden="true"></i>{t.hours}</li>
    </ul>
    <a class="lang-switch" href={switchHref} hreflang={ta ? 'en' : 'ta'} lang={ta ? 'en' : 'ta'}>{t.switchLabel}</a>
  </div>
</div>

<header class="site-header">
  <div class="container">
    <a class="brand" href={home} aria-label={`${SITE.brand} – ${SITE.name} home`}>
      <img
        src={SITE.logoSmall}
        srcset={`${SITE.logoSmall} 300w, ${SITE.logo} 600w`}
        sizes="80px"
        alt={`${SITE.brand} logo`}
        width="300" height="222"
        fetchpriority="high"
      />
      <span class="brand-text"><strong>{SITE.name}</strong><small>{ta ? 'தமிழ்நாடு நில அளவை நிபுணர்கள்' : 'Land Survey Experts · Tamil Nadu'}</small></span>
    </a>

    <nav class="main-nav" aria-label="Main">
      <ul>
        <li class="has-menu">
          <button class="menu-trigger" type="button" aria-haspopup="true">{t.services} <i class="fa-solid fa-chevron-down" aria-hidden="true"></i></button>
          <ul class="menu menu--mega">
            {SERVICES.map((s) => (
              <li>
                <a href={svcHref(s.slug)}>
                  <span class="mi"><i class={s.icon} aria-hidden="true"></i></span>
                  <span><strong>{ta ? s.ta.name : s.name}</strong>{!ta && <small>{s.short}</small>}</span>
                </a>
              </li>
            ))}
            {!ta && <li class="menu-foot"><a href="/services/" class="link-arrow">{t.allServices.replace(' →', '')}</a></li>}
          </ul>
        </li>
        <li><a href="/projects/" class="nav-highlight"><i class="fa-solid fa-medal" aria-hidden="true"></i>{t.work}</a></li>
        <li><a href="/locations/">{t.locations}</a></li>
        <li class="has-menu">
          <button class="menu-trigger" type="button" aria-haspopup="true">{t.company} <i class="fa-solid fa-chevron-down" aria-hidden="true"></i></button>
          <ul class="menu">
            {company.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
          </ul>
        </li>
        <li><a href="/survey-cost-estimator/">{t.estimator}</a></li>
        <li><a href={ta ? '/ta/contact/' : '/contact/'}>{t.contact}</a></li>
      </ul>
    </nav>

    <div class="header-actions">
      <a class="header-wa" href={waLink(ta ? 'வணக்கம் Cartospatial, எனக்கு நில அளவை பற்றி விவரம் வேண்டும்.' : 'Hi Cartospatial, I need details about a land survey.')} target="_blank" rel="noopener" data-track="whatsapp" aria-label="Chat on WhatsApp">
        <i class="fa-brands fa-whatsapp" aria-hidden="true"></i>
      </a>
      <button class="btn btn--sm js-open-request-form" type="button">{t.quote}</button>
      <button class="nav-toggle" type="button" aria-label={t.menu} aria-expanded="false" aria-controls="drawer">
        <i class="fa-solid fa-bars" aria-hidden="true"></i>
      </button>
    </div>
  </div>
</header>

<div class="drawer-overlay" role="presentation"></div>
<aside class="drawer" id="drawer" aria-label="Mobile navigation" aria-hidden="true">
  <div class="drawer-head">
    <img src={SITE.logoSmall} alt={`${SITE.brand} logo`} width="300" height="222" loading="lazy" />
    <button class="drawer-close" type="button" aria-label="Close menu"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
  </div>
  <nav aria-label="Mobile">
    <ul>
      <li><a href={home}>{t.home}</a></li>
      <li class="m-dropdown">
        <button class="m-trigger" type="button" aria-expanded="false">{t.services} <i class="fa-solid fa-chevron-down" aria-hidden="true"></i></button>
        <ul class="m-submenu">
          {SERVICES.map((s) => <li><a href={svcHref(s.slug)}>{ta ? s.ta.name : s.name}</a></li>)}
          {!ta && <li><a href="/services/"><strong>{t.allServices}</strong></a></li>}
        </ul>
      </li>
      <li><a href="/projects/">{t.work}</a></li>
      <li><a href="/locations/">{t.locations}</a></li>
      <li class="m-dropdown">
        <button class="m-trigger" type="button" aria-expanded="false">{t.company} <i class="fa-solid fa-chevron-down" aria-hidden="true"></i></button>
        <ul class="m-submenu">
          {company.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
        </ul>
      </li>
      <li><a href="/survey-cost-estimator/">{t.estimator}</a></li>
      <li><a href={ta ? '/ta/contact/' : '/contact/'}>{t.contact}</a></li>
      <li><a href={switchHref} hreflang={ta ? 'en' : 'ta'} lang={ta ? 'en' : 'ta'}>{t.switchLabel}</a></li>
    </ul>
  </nav>
  <div class="drawer-foot">
    <button class="btn btn--block js-open-request-form" type="button">{t.quote}</button>
    <a class="btn btn--outline btn--block only-mobile" href={`tel:${SITE.phoneRaw}`} data-track="call"><i class="fa-solid fa-phone" aria-hidden="true"></i> {SITE.phone}</a>
  </div>
</aside>
