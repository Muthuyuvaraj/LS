---
interface Props { faqs: { q: string; a: string }[]; title?: string; eyebrow?: string; alt?: boolean; lead?: string; id?: string }
const { faqs, title = 'Frequently Asked Questions', eyebrow = 'FAQ', alt = false, lead, id = 'faq-title' } = Astro.props;
---
<section class:list={['section', { 'section--alt': alt }]} aria-labelledby={id}>
  <div class="container faq-wrap">
    <div>
      <p class="eyebrow-label">{eyebrow}</p>
      <h2 class="section-heading" id={id}>{title}</h2>
      {lead && <p class="section-lead">{lead}</p>}
      <slot />
    </div>
    <div class="faq">
      {faqs.map((f, i) => (
        <details open={i === 0}>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
