---
interface Props { faqs: { q: string; a: string }[]; title?: string; eyebrow?: string; alt?: boolean }
const { faqs, title = 'Frequently Asked Questions', eyebrow = 'FAQ', alt = false } = Astro.props;
---
<section class:list={['section', { 'section--alt': alt }]} aria-labelledby="faq-title">
  <div class="section-inner">
    <p class="eyebrow-label">{eyebrow}</p>
    <h2 class="section-heading" id="faq-title">{title}</h2>
    <div class="faq">
      {faqs.map((f, i) => (
        <details open={i === 0}>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
