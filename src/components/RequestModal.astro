---
import { SERVICES } from '../data/services';
import { DISTRICTS } from '../data/districts';
interface Props { lang: 'en' | 'ta' }
const ta = Astro.props.lang === 'ta';
---
<div class="request-modal" id="request-modal" aria-hidden="true">
  <div class="request-modal__overlay"></div>
  <div class="request-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="requestModalTitle">
    <button class="request-modal__close" type="button" aria-label="Close form">&times;</button>
    <p id="requestModalTitle" class="request-modal__title">{ta ? 'திட்ட விலைப்புள்ளி கோருங்கள்' : 'Request a Project Quote'}</p>
    <p class="request-modal__subtitle">
      {ta ? 'உங்கள் நில அளவை தேவைகளைப் பகிருங்கள். தொலைபேசி / WhatsApp மூலம் விரைவில் தொடர்புகொள்வோம்.' : "Share your land surveying or mapping requirements. We'll get back via phone / WhatsApp with a tailored quote."}
    </p>
    <form id="request-online-form" data-lead-form="Quote modal" novalidate>
      <div class="form-grid">
        <div class="form-group">
          <label for="ro-name">{ta ? 'பெயர்' : 'Full Name'} <span class="req-star">*</span></label>
          <input id="ro-name" name="name" type="text" autocomplete="name" placeholder="Your Name" required />
        </div>
        <div class="form-group">
          <label for="ro-phone">{ta ? 'தொலைபேசி / WhatsApp' : 'Phone / WhatsApp'} <span class="req-star">*</span></label>
          <input id="ro-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" pattern="[0-9+\s-]{10,15}" placeholder="+91 XXXXX XXXXX" required />
        </div>
        <div class="form-group">
          <label for="ro-email">{ta ? 'மின்னஞ்சல் (விருப்பம்)' : 'Email (optional)'}</label>
          <input id="ro-email" name="email" type="email" autocomplete="email" placeholder="you@example.com" />
        </div>
        <div class="form-group">
          <label for="ro-company">{ta ? 'நிறுவனம் (விருப்பம்)' : 'Company (optional)'}</label>
          <input id="ro-company" name="company" type="text" autocomplete="organization" placeholder="Company name" />
        </div>
        <div class="form-group">
          <label for="ro-service">{ta ? 'தேவையான சேவை' : 'Required Service'} <span class="req-star">*</span></label>
          <select id="ro-service" name="service" required>
            <option value="">{ta ? 'சேவையைத் தேர்ந்தெடுக்கவும்' : 'Select a service'}</option>
            {SERVICES.map((s) => <option value={s.name}>{ta ? s.ta.name : s.name}</option>)}
            <option value="Patta / FMB boundary fixing">Patta / FMB boundary fixing</option>
            <option value="Other">{ta ? 'மற்றவை' : 'Other'}</option>
          </select>
        </div>
        <div class="form-group">
          <label for="ro-location">{ta ? 'நிலம் உள்ள இடம் / மாவட்டம்' : 'Site Location / District'} <span class="req-star">*</span></label>
          <input id="ro-location" name="location" type="text" list="tn-districts" placeholder="e.g. Kumbakonam, Thanjavur" required />
          <datalist id="tn-districts">{DISTRICTS.map((d) => <option value={d.name} />)}</datalist>
        </div>
      </div>
      <div class="form-group" style="margin-top:10px;">
        <label for="ro-message">{ta ? 'திட்ட விவரங்கள்' : 'Project Details'} <span class="req-star">*</span></label>
        <textarea id="ro-message" name="message" placeholder={ta ? 'நிலப் பரப்பு (ஏக்கர்/சென்ட்), நோக்கம், காலக்கெடு' : 'Area (acres / cents / sq.ft), purpose and timeline'} required></textarea>
      </div>
      <div class="form-group" style="margin-top:8px;">
        <label for="ro-contact-pref">{ta ? 'தொடர்பு முறை' : 'Preferred Contact'}</label>
        <select id="ro-contact-pref" name="contactPreference">
          <option value="WhatsApp">WhatsApp</option>
          <option value="Phone call">{ta ? 'தொலைபேசி அழைப்பு' : 'Phone Call'}</option>
          <option value="Email">Email</option>
        </select>
      </div>
      <input type="checkbox" name="botcheck" class="hp-field" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <div class="checkbox-row">
        <input id="ro-accept" type="checkbox" required />
        <label for="ro-accept">{ta ? 'Cartospatial Technologies என்னைத் தொடர்புகொள்ள ஒப்புக்கொள்கிறேன்.' : 'I agree to be contacted by Cartospatial Technologies via phone / WhatsApp / email.'}</label>
      </div>
      <button type="submit" class="btn-submit">{ta ? 'சமர்ப்பிக்கவும்' : 'Submit Request'}</button>
      <p class="form-status" role="status" aria-live="polite"></p>
    </form>
  </div>
</div>
