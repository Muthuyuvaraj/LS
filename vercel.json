{
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/pages/Home.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/pages/about.html",
      "destination": "/about/",
      "permanent": true
    },
    {
      "source": "/pages/team.html",
      "destination": "/team/",
      "permanent": true
    },
    {
      "source": "/pages/project.html",
      "destination": "/projects/",
      "permanent": true
    },
    {
      "source": "/pages/contact.html",
      "destination": "/contact/",
      "permanent": true
    },
    {
      "source": "/pages/services/Totalstation.html",
      "destination": "/services/total-station-survey/",
      "permanent": true
    },
    {
      "source": "/pages/services/DGPS.html",
      "destination": "/services/dgps-survey/",
      "permanent": true
    },
    {
      "source": "/pages/services/Drone.html",
      "destination": "/services/drone-survey/",
      "permanent": true
    },
    {
      "source": "/pages/services/Photogrammetry.html",
      "destination": "/services/photogrammetry/",
      "permanent": true
    },
    {
      "source": "/pages/services/Lidar.html",
      "destination": "/services/lidar-survey/",
      "permanent": true
    },
    {
      "source": "/pages/services/Bathymetric.html",
      "destination": "/services/bathymetric-survey/",
      "permanent": true
    },
    {
      "source": "/pages/services/GIS.html",
      "destination": "/services/gis-mapping/",
      "permanent": true
    },
    {
      "source": "/pages/services/Dataprocessing.html",
      "destination": "/services/data-processing/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.cartospatialtechnologies.com"
        }
      ],
      "destination": "https://cartospatialtechnologies.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
