# Copy to .env and fill in. All are optional – features switch on when a value is present.

# Google Analytics 4 measurement ID (tracks calls, WhatsApp clicks, form leads, estimator use)
PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Search Console HTML-tag verification code (content="...")
PUBLIC_GSC_VERIFICATION=

# Web3Forms access key – emails every enquiry to cartospatialtechnologies@gmail.com (free: https://web3forms.com)
PUBLIC_WEB3FORMS_KEY=

# Google Apps Script web-app URL – saves every enquiry as a row in a Google Sheet (see docs/google-sheet-leads.md)
PUBLIC_SHEETS_WEBHOOK=
